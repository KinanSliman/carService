# Local Postgres (docker compose up -d).
# The container publishes on 5433, because a system PostgreSQL install commonly
# already owns 5432. Override with KARAJ_DB_PORT if yours is free.
DATABASE_URL="postgresql://karaj:karaj@localhost:5433/karaj"

# Optional. Managed providers hand out a pooled endpoint and a direct one; the
# app uses DATABASE_URL (pooled), while migrations and the seed prefer this one,
# because pgbouncer in transaction mode does not keep a session across
# statements.
# DATABASE_URL_UNPOOLED="postgresql://...@ep-xxx.region.aws.neon.tech/db?sslmode=require"

# Optional. "postgres" (wire protocol, port 5432) or "neon-http" (SQL over
# HTTPS). A *.neon.tech host defaults to neon-http, because plenty of networks
# accept the TCP handshake on 5432 and then reset the connection. Only affects
# the CLI scripts, never the running app.
# DATABASE_DRIVER="neon-http"

# Used for canonical URLs, OG tags and sitemap
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Protects /api/cron/cleanup. Vercel sends this as `Authorization: Bearer <secret>`.
CRON_SECRET="change-me"
