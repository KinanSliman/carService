{
  "name": "karaj",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:drop": "tsx src/db/drop.ts",
    "db:reset": "pnpm db:up && pnpm db:drop && pnpm db:migrate && pnpm db:seed",
    "db:seed:prod": "dotenv -e .env.production -- tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:migrate:prod": "dotenv -e .env.production -- tsx src/db/migrate.ts"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "motion": "^11.15.0",
    "next": "15.5.25",
    "next-intl": "^4.14.2",
    "postgres": "^3.4.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@neondatabase/serverless": "^0.10.4",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "sharp": "^0.35.4",
      "postcss": "^8.5.28",
      "esbuild": "^0.25.12",
      "vite": "^6.4.3"
    }
  }
}
